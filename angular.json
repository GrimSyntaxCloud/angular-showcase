{
  "version": 1,
  "projects": {
    "reading-room": {
      "projectType": "application",
      "root": "apps/reading-room",
      "sourceRoot": "apps/reading-room",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "apps/reading-room/main.ts",
            "index": "apps/reading-room/index.html",
            "tsConfig": "apps/reading-room/tsconfig.json",
            "styles": ["apps/reading-room/styles.css"],
            "outputPath": {
              "base": "dist/reading-room",
              "browser": ""
            },
            "baseHref": "./",
            "outputHashing": "all",
            "budgets": [
              {
                "type": "initial",
                "maximumWarning": "600kb",
                "maximumError": "1mb"
              }
            ]
          }
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "buildTarget": "reading-room:build"
          }
        }
      }
    },
    "grade-lab": {
